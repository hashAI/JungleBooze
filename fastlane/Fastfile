# iOS build, signing and TestFlight upload. Run through tools/build/build_ios.sh, which loads the owner's
# private settings file and checks prerequisites first. See docs/RELEASE.md.
#
# Lanes:
#   fastlane ios preflight          Check tools, settings, git state and the App Store Connect key. Builds nothing.
#   fastlane ios beta               Unity -> Xcode project -> signed archive -> TestFlight upload.
#       options: build_type:development   Development player (default: release, or JB_BUILD_TYPE)
#   fastlane ios certs              Download signing certificate + profile from the match repo (read-only).
#       options: readonly:false           Create or renew them (first-time setup only).
#
# Settings (environment variables; secrets never live in this repository):
#   JB_BUNDLE_ID, APPLE_TEAM_ID                 App identity
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH     App Store Connect API key (.p8 file kept outside the repo)
#   MATCH_GIT_URL, MATCH_PASSWORD               Private certificates repository (see Matchfile)
#   UNITY_PATH                                  Optional: Unity editor binary (default: Unity Hub location)
#   JB_BUILD_TYPE                               Optional: release (default) or development
#   JB_BUILD_NUMBER                             Optional: force a build number (default: latest TestFlight + 1)
#   JB_RELEASE_BRANCH                           Optional: branch builds must come from (default: main)
#   JB_WHAT_TO_TEST                             Optional: "What to Test" text for testers
#
# The marketing version (for example 0.1.0) comes from the VERSION file at the repository root.

require "fileutils"

default_platform(:ios)

# Do not regenerate fastlane/README.md: it would leave the working copy changed and block the next build.
skip_docs

REPO_ROOT = `git rev-parse --show-toplevel`.strip
UNITY_PROJECT = File.join(REPO_ROOT, "UnityProject")
BUILD_ROOT = File.join(UNITY_PROJECT, "Builds") # ignored by git
XCODE_EXPORT = File.join(BUILD_ROOT, "iOS")
XCODE_PROJECT = File.join(XCODE_EXPORT, "Unity-iPhone.xcodeproj")
IPA_DIR = File.join(BUILD_ROOT, "ipa")
LOG_DIR = File.join(BUILD_ROOT, "logs")
UNITY_BUILD_METHOD = "JungleBooze.Editor.Build.BuildScript.BuildIos"
APP_TARGET = "Unity-iPhone"
SETTINGS_HINT = "Add it to ~/.junglebooze/release.env (see docs/RELEASE.md, step 8)."

def read_key_values(path)
  File.readlines(path).each_with_object({}) do |line, values|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    values[key.strip] = value.to_s.strip
  end
end

def required_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing setting #{name}. #{SETTINGS_HINT}") if value.empty?
  value
end

def bundle_id
  required_env("JB_BUNDLE_ID")
end

def team_id
  required_env("APPLE_TEAM_ID")
end

def marketing_version
  version = File.read(File.join(REPO_ROOT, "VERSION")).strip
  unless version.match?(/\A(0|[1-9]\d{0,3})\.(0|[1-9]\d{0,3})\.(0|[1-9]\d{0,3})\z/)
    UI.user_error!("VERSION file must contain three numbers like 0.1.0, found '#{version}'.")
  end
  version
end

def build_type(options)
  type = (options[:build_type] || ENV["JB_BUILD_TYPE"] || "release").to_s.strip.downcase
  UI.user_error!("Build type must be 'release' or 'development', found '#{type}'.") unless %w[release development].include?(type)
  type
end

# App Store Connect API key: no Apple ID password or two-factor prompts.
def asc_api_key
  key_path = File.expand_path(required_env("ASC_KEY_PATH"))
  UI.user_error!("App Store Connect key file not found at #{key_path}. #{SETTINGS_HINT}") unless File.file?(key_path)

  app_store_connect_api_key(
    key_id: required_env("ASC_KEY_ID"),
    issuer_id: required_env("ASC_ISSUER_ID"),
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

# Apple rejects uploads built with an older Xcode/SDK. Minimums live in tools/build/apple-minimums.env.
def ensure_apple_minimums
  minimums = read_key_values(File.join(REPO_ROOT, "tools", "build", "apple-minimums.env"))
  min_xcode = minimums.fetch("MIN_XCODE_MAJOR").to_i
  min_sdk = minimums.fetch("MIN_IOS_SDK_MAJOR").to_i

  xcode_text = sh("xcodebuild", "-version", log: false)
  xcode_major = xcode_text[/Xcode\s+(\d+)/, 1].to_i
  sdk_text = sh("xcrun", "--sdk", "iphoneos", "--show-sdk-version", log: false).strip
  sdk_major = sdk_text.split(".").first.to_i

  if xcode_major < min_xcode
    UI.user_error!("Xcode #{xcode_major} is installed, but App Store uploads need Xcode #{min_xcode} or newer. " \
                   "Update Xcode from the Mac App Store.")
  end
  if sdk_major < min_sdk
    UI.user_error!("The iOS SDK is #{sdk_text}, but App Store uploads need iOS SDK #{min_sdk} or newer. " \
                   "Update Xcode, then run: sudo xcode-select -s /Applications/Xcode.app")
  end
  UI.success("Xcode #{xcode_major}, iOS SDK #{sdk_text} (minimum: Xcode #{min_xcode}, SDK #{min_sdk}).")
end

# A build that goes to Apple must come from a clean, merged, pushed commit on the release branch.
def ensure_release_source
  branch = ENV.fetch("JB_RELEASE_BRANCH", "main").strip
  ensure_git_status_clean(show_uncommitted_changes: true)

  current = sh("git", "rev-parse", "--abbrev-ref", "HEAD", log: false).strip
  unless current == branch
    UI.user_error!("This folder is on branch '#{current}', but builds must come from '#{branch}'. " \
                   "Run: git checkout #{branch} && git pull")
  end

  sh("git", "fetch", "--quiet", "origin", branch, log: false)
  local = sh("git", "rev-parse", "HEAD", log: false).strip
  remote = sh("git", "rev-parse", "origin/#{branch}", log: false).strip
  unless local == remote
    UI.user_error!("Your copy of '#{branch}' is not the same as the one on GitHub. Run: git pull " \
                   "(if that reports local changes, ask the team before building).")
  end
  local
end

def unity_editor_path
  custom = ENV["UNITY_PATH"].to_s.strip
  return custom unless custom.empty?

  version_file = File.read(File.join(UNITY_PROJECT, "ProjectSettings", "ProjectVersion.txt"))
  version = version_file[/m_EditorVersion:\s*(\S+)/, 1]
  "/Applications/Unity/Hub/Editor/#{version}/Unity.app/Contents/MacOS/Unity"
end

def next_build_number(api_key)
  forced = ENV["JB_BUILD_NUMBER"].to_s.strip
  return forced unless forced.empty?

  latest = latest_testflight_build_number(api_key: api_key, app_identifier: bundle_id, initial_build_number: 0)
  (latest.to_i + 1).to_s
end

def build_xcode_project_with_unity(version:, build_number:, type:)
  unity = unity_editor_path
  unless File.executable?(unity)
    UI.user_error!("Unity editor not found at #{unity}. Install the version in " \
                   "UnityProject/ProjectSettings/ProjectVersion.txt with Unity Hub, or set UNITY_PATH.")
  end

  FileUtils.mkdir_p(LOG_DIR)
  log_file = File.join(LOG_DIR, "unity-ios-#{build_number}.log")
  UI.message("Unity is creating the Xcode project. This can take 5 to 30 minutes. Log: #{log_file}")

  failed = false
  sh(unity, "-batchmode", "-quit",
     "-projectPath", UNITY_PROJECT,
     "-buildTarget", "iOS",
     "-executeMethod", UNITY_BUILD_METHOD,
     "-logFile", log_file,
     "-jbBundleId", bundle_id,
     "-jbVersion", version,
     "-jbBuildNumber", build_number,
     "-jbBuildType", type,
     "-jbOutput", XCODE_EXPORT,
     "-jbTeamId", team_id,
     log: false,
     error_callback: ->(_output) { failed = true })

  return unless failed

  tail = File.exist?(log_file) ? File.readlines(log_file).last(40).join : "(Unity wrote no log)"
  UI.error(tail)
  UI.user_error!("Unity could not create the Xcode project. Send this file to the team: #{log_file}")
end

def what_to_test(version, build_number, commit)
  custom = ENV["JB_WHAT_TO_TEST"].to_s.strip
  body = if custom.empty?
           changes = sh("git", "log", "-15", "--first-parent", "--pretty=format:- %s", log: false).strip
           "Recent changes:\n#{changes}"
         else
           custom
         end
  "Build #{version} (#{build_number}) from commit #{commit[0, 8]}.\n\n#{body}"[0, 3900]
end

platform :ios do
  desc "Check tools, settings, git state and the App Store Connect key without building"
  lane :preflight do
    ensure_apple_minimums
    ensure_release_source
    %w[JB_BUNDLE_ID APPLE_TEAM_ID MATCH_GIT_URL MATCH_PASSWORD].each { |name| required_env(name) }
    api_key = asc_api_key
    UI.success("App Store Connect key works. Next build number would be #{next_build_number(api_key)}.")
    UI.success("Version #{marketing_version}, bundle id #{bundle_id}, Unity #{unity_editor_path}")
  end

  desc "Download the App Store signing certificate and profile (read-only unless readonly:false)"
  lane :certs do |options|
    readonly = options.fetch(:readonly, true).to_s != "false"
    UI.important("Creating or renewing certificates (readonly:false).") unless readonly
    match(
      type: "appstore",
      readonly: readonly,
      api_key: asc_api_key,
      app_identifier: [bundle_id],
      team_id: team_id
    )
  end

  desc "Build with Unity, archive, sign and upload to TestFlight"
  lane :beta do |options|
    ensure_apple_minimums
    commit = ensure_release_source
    type = build_type(options)
    version = marketing_version
    api_key = asc_api_key
    build_number = next_build_number(api_key)
    UI.header("Building #{bundle_id} #{version} (#{build_number}), #{type}, commit #{commit[0, 8]}")

    # Signing first: it is quick, so problems show up before the long Unity build.
    match(type: "appstore", readonly: true, api_key: api_key, app_identifier: [bundle_id], team_id: team_id)
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][bundle_id]
    UI.user_error!("No App Store provisioning profile found for #{bundle_id}. Run certs setup (docs/RELEASE.md).") if profile_name.to_s.empty?

    build_xcode_project_with_unity(version: version, build_number: build_number, type: type)

    update_code_signing_settings(
      path: XCODE_PROJECT,
      use_automatic_signing: false,
      targets: [APP_TARGET],
      build_configurations: ["Release"],
      team_id: team_id,
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    # The game uses no non-exempt encryption (see docs/APP_STORE_CHECKLIST.md); avoids the export-compliance prompt.
    set_info_plist_value(
      path: File.join(XCODE_EXPORT, "Info.plist"),
      key: "ITSAppUsesNonExemptEncryption",
      value: false
    )

    ipa_path = build_app(
      project: XCODE_PROJECT,
      scheme: APP_TARGET,
      configuration: "Release",
      clean: true,
      export_method: "app-store-connect",
      export_options: {
        provisioningProfiles: { bundle_id => profile_name },
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true
      },
      include_symbols: true,
      output_directory: IPA_DIR,
      output_name: "game-#{version}-#{build_number}.ipa",
      buildlog_path: LOG_DIR
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: ipa_path,
      changelog: what_to_test(version, build_number, commit),
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )

    File.write(
      File.join(LOG_DIR, "build-#{build_number}.txt"),
      "version=#{version}\nbuild=#{build_number}\ntype=#{type}\ncommit=#{commit}\n" \
      "bundle_id=#{bundle_id}\nxcode=#{sh('xcodebuild', '-version', log: false).lines.first.to_s.strip}\n"
    )
    UI.success("Build #{version} (#{build_number}) is on TestFlight. Testers get it once Apple finishes processing.")
  end
end
