# ---- Unity (project lives in UnityProject/) ----
/UnityProject/[Ll]ibrary/
/UnityProject/[Tt]emp/
/UnityProject/[Oo]bj/
/UnityProject/[Bb]uild/
/UnityProject/[Bb]uilds/
/UnityProject/[Ll]ogs/
/UnityProject/[Uu]ser[Ss]ettings/
/UnityProject/[Mm]emoryCaptures/
/UnityProject/[Rr]ecordings/

# Addressables build output (rebuilt by CI); keep the settings assets under Assets/AddressableAssetsData
/UnityProject/ServerData/
/UnityProject/Assets/AddressableAssetsData/*/*.bin*
/UnityProject/Assets/StreamingAssets/aa.meta
/UnityProject/Assets/StreamingAssets/aa/*

# Generated IDE / solution files
/UnityProject/*.csproj
/UnityProject/*.sln
/UnityProject/*.slnx
/UnityProject/*.unityproj
/UnityProject/*.suo
/UnityProject/*.user
/UnityProject/*.userprefs
/UnityProject/*.pidb
/UnityProject/*.booproj
/UnityProject/*.svd
/UnityProject/*.pdb
/UnityProject/*.mdb
/UnityProject/*.opendb
/UnityProject/*.VC.db
.vs/
.vscode/
.idea/
.gradle/

# Unity crash / profiler / build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
*.ipa
*.dSYM.zip
*.dSYM/
/UnityProject/Assets/Plugins/Editor/JetBrains*

# Test results and CI artifacts
/artifacts/
/UnityProject/TestResults*.xml
/UnityProject/*.trace

# iOS / Xcode output (Unity exports the Xcode project into Builds/)
DerivedData/
*.xcuserstate
xcuserdata/
/fastlane/report.xml
/fastlane/README.md
/fastlane/Preview.html
/fastlane/screenshots/**/*.png
/fastlane/test_output/

# Secrets: never commit licenses, keys, certificates or profiles
*.ulf
*.alf
*.p12
*.p8
*.mobileprovision
*.cer
*.keystore
.env
.env.*

# Python tooling (tools/)
__pycache__/
*.pyc
.venv/
/tools/sim/__pycache__/
# Raw sim outputs are regenerated by tools/sim/run_targets.py; the committed artifact is docs/sim-reports/*.md
/tools/sim/out/

# OS
.DS_Store
Thumbs.db
