# JungleBooze release settings for YOUR Mac. This is only a template: it is safe to keep in the repository
# because it contains no real values.
#
# Create your private copy (outside the repository) with:
#     tools/build/build_ios.sh --init
# which copies this file to ~/.junglebooze/release.env and makes it readable only by you.
# Then fill in the values below. NEVER put the filled-in file, the .p8 key, or passwords in the repository,
# in chat messages, or in screenshots.
#
# Format: NAME=value on one line, no spaces around "=". Put the value in single quotes if it contains
# spaces or special characters, for example MATCH_PASSWORD='my long passphrase'.

# ---- App identity (docs/RELEASE.md steps 3 and 4) ----
# Bundle identifier registered in the Apple Developer portal, for example com.yourname.yourgame
JB_BUNDLE_ID=
# 10-character Team ID from developer.apple.com > Account > Membership details
APPLE_TEAM_ID=

# ---- App Store Connect API key (docs/RELEASE.md step 5) ----
# Key ID and Issuer ID from App Store Connect > Users and Access > Integrations > App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
# Full path to the downloaded AuthKey_XXXXXXXXXX.p8 file. Keep it in ~/.junglebooze/, not in the repository.
ASC_KEY_PATH=$HOME/.junglebooze/AuthKey_REPLACE_ME.p8

# ---- Signing certificates storage (docs/RELEASE.md step 6) ----
# HTTPS address of your PRIVATE certificates repository, for example https://github.com/yourname/ios-certificates.git
MATCH_GIT_URL=
# Password that encrypts that repository. Choose a long one and also store it in your password manager.
MATCH_PASSWORD=

# ---- Optional ----
# Unity editor binary, only if Unity Hub installed it somewhere unusual:
# UNITY_PATH=/Applications/Unity/Hub/Editor/6000.3.0f1/Unity.app/Contents/MacOS/Unity
# release (default) or development (development builds show a "Development Build" label):
# JB_BUILD_TYPE=release
# Text testers see under "What to Test" in TestFlight (default: list of recent changes):
# JB_WHAT_TO_TEST='Feel check: rate swipe response, run speed and jump.'
# Branch builds must come from (default: main):
# JB_RELEASE_BRANCH=main
