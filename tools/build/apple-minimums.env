# Minimum Apple tool versions for App Store Connect uploads.
# Read by tools/build/build_ios.sh and fastlane/Fastfile. Plain KEY=VALUE lines only (no quotes, no spaces).
#
# Source: https://developer.apple.com/news/upcoming-requirements/  (checked 2026-10-06)
#   "Since April 28, 2026: Apps uploaded to App Store Connect must be built with Xcode 26 or later
#    using an SDK for iOS 26 ..."
#   "Since September 9, 2026: iOS and iPadOS apps uploaded to App Store Connect must target iOS 13 or later."
# Announced next step: https://developer.apple.com/app-store/submitting/  (checked 2026-10-06)
#   "Starting April 2027": built with the iOS & iPadOS 27 SDK or later, and target iOS 15 or later.
#
# Release engineer: re-check both pages before every submission and raise these numbers when Apple does.
MIN_XCODE_MAJOR=26
MIN_IOS_SDK_MAJOR=26
CHECKED_ON=2026-10-06
